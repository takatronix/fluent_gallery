# データの正本(画像/サイドカー/索引) — コードと分離、バックアップは別系統で
/store/
# ビルド成果物
/target/
# 大きいモデルファイル(自動DLされる)
/engine/models/
# 生成エンジンの実行ファイル(各OSで自前ビルド/同梱。500MB級)
/engine/bin/
/engine/cuda/
/engine/*.png
/engine/refs/
/mac/tauri/src-tauri/sd/
# サンプル源の注釈ファイル(COCO 253MB / Open Images CSV など。初回に自動DL)
/engine/data/
# 実行ログ/キャッシュ
*.log
__pycache__/
node_modules/
/dist/
target/
/mac/tauri/src-tauri/binaries/
/mac/tauri/src-tauri/gen/

